<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CppStudentClient</AssemblyName>
    <RootNamespace>CppStudentClient</RootNamespace>
    <Version>1.9.5</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>CV+ Compilatore Alunno</Product>
    <Company>Alessandro Barazzuol</Company>
    <Copyright>© Alessandro Barazzuol</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.75.0.4210" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Non compilare mai vecchi sorgenti presenti nelle cartelle di backup. -->
    <Compile Remove="backup_*\**\*.cs" />
    <Compile Remove="COMPILATORE_*\**\*.cs" />
    <Compile Remove="__pycache__\**\*.cs" />
    <Compile Remove="CVPlus.Mac\**\*.cs" />
    <Compile Remove="macos\**\*.cs" />
    <None Remove="backup_*\**\*" />
    <None Remove="COMPILATORE_*\**\*" />
    <None Remove="CVPlus.Mac\**\*" />
    <None Remove="macos\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\google_oauth_client.json" Condition="Exists('Assets\google_oauth_client.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Include="Assets\google_oauth_client.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\CppGuides\**\*.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\SampleLibraries\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
