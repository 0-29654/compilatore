<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CVPlus.Mac.Views.MainWindow"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        Title="CV+ Compilatore Alunno — macOS Apple Silicon" Width="1280" Height="820" MinWidth="980" MinHeight="650" Background="#F2F5F9">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">
    <Border Grid.Row="0" Background="#132238" CornerRadius="10" Padding="15">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel><TextBlock Text="CV+ COMPILATORE ALUNNO" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="Versione macOS Apple Silicon — C++17 con Apple clang++" Foreground="#B9C8DC"/></StackPanel>
        <TextBlock Grid.Column="1" x:Name="ModeText" Text="ESERCITAZIONE" Foreground="#65F59B" FontWeight="Bold" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="100,170,120,100,220,150" Margin="0,12,0,10" ColumnSpacing="8">
      <StackPanel><TextBlock Text="N. registro"/><TextBox x:Name="RegisterBox"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Nome e cognome"/><TextBox x:Name="NameBox"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Classe"/><TextBox x:Name="ClassBox"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text="Esercizio"/><NumericUpDown x:Name="ExerciseBox" Minimum="1" Maximum="999" Value="1"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="IP DOCENTE : PORTA"/><TextBox x:Name="ServerBox" Watermark="Rilevamento automatico..."/></StackPanel>
      <StackPanel Grid.Column="5"><TextBlock Text="CODICE SESSIONE"/><TextBox x:Name="SessionBox"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="10">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Text="main.cpp  (Shift + clic per editor grande)" FontWeight="SemiBold" Margin="3"/>
        <ae:TextEditor Grid.Row="1" x:Name="Editor" FontFamily="Menlo, SFMono-Regular, monospace" FontSize="14" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFFFFF" Foreground="#1F2328"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button x:Name="CompileButton" Content="Compila ed esegui" Click="Compile_Click"/>
          <Button Content="Invia al docente" Click="Send_Click"/>
          <Button Content="Pulisci console" Click="ClearConsole_Click"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" RowDefinitions="Auto,180,Auto,*">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="esercizio.h" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="HeaderLockText" Text="BLOCCATO DAL DOCENTE" Foreground="#B42318" FontSize="11"/></Grid>
        <ae:TextEditor Grid.Row="1" x:Name="HeaderEditor" FontFamily="Menlo, SFMono-Regular, monospace" FontSize="13" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFFFFF" Foreground="#1F2328"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5" Margin="0,6">
          <Button x:Name="AddHeaderButton" Content="Aggiungi .h" IsEnabled="False" Click="AddHeader_Click"/>
          <Button x:Name="RenameHeaderButton" Content="Rinomina .h" IsEnabled="False" Click="RenameHeader_Click"/>
          <Button x:Name="DeleteHeaderButton" Content="Elimina .h" IsEnabled="False" Click="DeleteHeader_Click"/>
        </StackPanel>
        <Border Grid.Row="3" Background="#050705" CornerRadius="7" Padding="10">
          <ScrollViewer x:Name="ConsoleScroll"><StackPanel x:Name="ConsolePanel"/></ScrollViewer>
        </Border>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="StatusText" Text="Pronto — ricerca del docente in corso" Margin="3,9,3,0"/>
  </Grid>
</Window>
