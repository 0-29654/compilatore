<Window x:Class="CppStudentClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="CV+ Compilatore Alunno" Width="1280" Height="860" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#07111F" Icon="Assets/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#101D31"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#18A9F5"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F8FC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A8B5C7"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A1526"/>
            <Setter Property="Foreground" Value="#F5F8FC"/>
            <Setter Property="BorderBrush" Value="#2A3A52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0A1526"/>
            <Setter Property="Foreground" Value="#F5F8FC"/>
            <Setter Property="BorderBrush" Value="#2A3A52"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="1,0,0,5"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#24344D"/>
            <Setter Property="BorderBrush" Value="#354966"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="108"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="EditorRow" Height="*" MinHeight="220"/>
            <RowDefinition Height="7"/>
            <RowDefinition x:Name="OutputRow" Height="120" MinHeight="58"/>
            <RowDefinition Height="82"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1729" BorderBrush="#20324C" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="58" Height="58" CornerRadius="15" Background="#0E5DA8" VerticalAlignment="Center">
                    <TextBlock Text="C++" Foreground="#AEE8FF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="CV+ Compilatore Alunno" Foreground="White" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="Scrivi, compila in C++17 e invia il tuo esercizio al docente" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                    <TextBlock Text="© Alessandro Barazzuol" Foreground="#8FE8FF" FontSize="16" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="#0F3550" BorderBrush="#2AAEFF" BorderThickness="1"
                                CornerRadius="11" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="STANDARD" Foreground="#A8B5C7" FontSize="10"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="C++17" Foreground="#B7F3FF" FontWeight="ExtraBold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="GuideButton" Content="?  GUIDA" Click="Guide_Click"
                                Style="{StaticResource ModernButton}" Padding="12,7" Margin="0,0,8,0"
                                Background="#0F3550" BorderBrush="#2AAEFF"
                                ToolTip="Apri la guida visuale del compilatore"/>
                        <Border x:Name="ModeBadge" Background="#102D25" BorderBrush="#1F6D55"
                                BorderThickness="1" CornerRadius="14" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ModeDot" Width="8" Height="8" Fill="#34D399"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="ModeText" Text="ESERCITAZIONE"
                                           Foreground="#B9F7DC" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Compilatore C++17 incluso nell'installazione"
                               Foreground="#7E93AE" FontSize="10" HorizontalAlignment="Right"
                               Margin="0,5,2,0"/>
                    <TextBlock x:Name="ExerciseTimeText" Text="Tempo esercizio: 00:00:00"
                               Foreground="#91A4BD" FontSize="11" HorizontalAlignment="Right"
                               Margin="0,4,2,0"/>
                    <TextBlock x:Name="LocalIpText" Text="IP: rilevamento..."
                               Foreground="#6F849F" FontSize="10" HorizontalAlignment="Right"
                               Margin="0,2,2,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Margin="16,14,16,10" Padding="14"
                BorderBrush="#243650" BorderThickness="1">
            <!-- Layout superiore diviso nelle stesse due zone dell'area editor:
                 dati alunno a sinistra, connessione docente a destra (400 px)
                 così IP/porta/sessione risultano allineati con SHELL / ESTENSIONI. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <!-- Campi più compatti: liberano spazio a destra per i controlli zoom. -->
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="4">
                        <TextBlock Text="N° REGISTRO ALU." Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="StudentIdBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4">
                        <TextBlock Text="NOME E COGNOME" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="StudentNameBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4">
                        <TextBlock Text="CLASSE" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="ClassBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="4">
                        <TextBlock Text="TIPOLOGIA" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TaskTypeBox" Text="A" LostFocus="TaskIdentity_LostFocus"
                                 HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Column="4" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <!-- La didascalia è centrata esattamente sopra la casella del numero. -->
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="N° ESERCIZIO" Style="{StaticResource LabelStyle}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>

                        <Button x:Name="PreviousExerciseButton" Grid.Row="1" Grid.Column="0" Content="◀" Width="30" Height="32"
                                Click="PreviousExercise_Click" Style="{StaticResource ModernButton}" Padding="3" Margin="0,0,3,0"/>
                        <TextBox x:Name="ExerciseBox" Grid.Row="1" Grid.Column="1" Text="1" LostFocus="ExerciseNumber_LostFocus"
                                 HorizontalContentAlignment="Center" FontWeight="SemiBold" Padding="4,6"/>
                        <Button x:Name="NextExerciseButton" Grid.Row="1" Grid.Column="2" Content="▶" Width="30" Height="32"
                                Click="NextExercise_Click" Style="{StaticResource ModernButton}" Padding="3" Margin="3,0,0,0"
                                Background="#0E78C7" BorderBrush="#2AAEFF"/>

                        <!-- Zoom: icone lente più/meno, più grandi e ben separate dalla navigazione esercizio. -->
                        <Button x:Name="EditorZoomOutButton" Grid.Row="1" Grid.Column="4" Width="34" Height="34"
                                Click="EditorZoomOut_Click" Style="{StaticResource ModernButton}" Padding="3" Margin="0,0,4,0"
                                Background="#4C3F91" BorderBrush="#8B7CF6"
                                ToolTip="Zoom out — riduci la dimensione del codice">
                            <Grid Width="22" Height="22">
                                <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="2"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"/>
                                <Line X1="10" Y1="10" X2="19" Y2="19" Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="4" Y1="7" X2="10" Y2="7" Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button>
                        <Button x:Name="EditorZoomInButton" Grid.Row="1" Grid.Column="5" Width="34" Height="34"
                                Click="EditorZoomIn_Click" Style="{StaticResource ModernButton}" Padding="3" Margin="3,0,0,0"
                                Background="#087EBD" BorderBrush="#38BDF8"
                                ToolTip="Zoom in — aumenta la dimensione del codice">
                            <Grid Width="22" Height="22">
                                <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="2"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"/>
                                <Line X1="10" Y1="10" X2="19" Y2="19" Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="4" Y1="7" X2="10" Y2="7" Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="7" Y1="4" X2="7" Y2="10" Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1" Margin="4,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="0.72*"/>
                        <ColumnDefinition Width="1.05*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ServerBox conserva internamente IP:porta perché il resto del programma usa questo valore.
                         È nascosto: all'alunno mostriamo i due valori separati e non modificabili. -->
                    <TextBox x:Name="ServerBox" Visibility="Collapsed" IsReadOnly="True" IsTabStop="False" Focusable="False"
                             TextChanged="ServerBox_TextChanged"/>

                    <StackPanel Grid.Column="0" Margin="2,4,4,4">
                        <TextBlock Text="IP DOCENTE" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="ServerIpDisplay" IsReadOnly="True" IsTabStop="False" Focusable="False"
                                 Background="#162235" Foreground="#B9C7D8" BorderBrush="#40516A"
                                 FontSize="12" Padding="7,7" ToolTip="Valore ricevuto automaticamente dal programma docente."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4">
                        <TextBlock Text="PORTA" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="ServerPortDisplay" IsReadOnly="True" IsTabStop="False" Focusable="False"
                                 Background="#162235" Foreground="#B9C7D8" BorderBrush="#40516A"
                                 FontSize="12" Padding="7,7" HorizontalContentAlignment="Center"
                                 ToolTip="Valore ricevuto automaticamente dal programma docente."/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4">
                        <TextBlock Text="CODICE SESSIONE" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="SessionBox" IsReadOnly="True" IsTabStop="False" Focusable="False"
                                 Background="#162235" Foreground="#B9C7D8" BorderBrush="#40516A"
                                 FontSize="12" Padding="7,7" ToolTip="Valore ricevuto automaticamente dal programma docente e non modificabile."/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="16,0,16,0" CornerRadius="14" Background="#050B14" BorderBrush="#2B4567" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="#181818" BorderBrush="#333333" BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="C++  ›  main.cpp" Foreground="#CCCCCC" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="CV+ EDITOR — C++17" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="ShellButton" Content=">_ SHELL" Click="Shell_Click" Style="{StaticResource ModernButton}" Padding="10,5" Margin="0,3,8,3" Background="#166534" BorderBrush="#22C55E" ToolTip="Apri la shell CMD nella cartella Documenti con G++ già nel PATH"/>
                            <Button x:Name="CppExtensionsButton" Content="▣ ESTENSIONI C++" IsEnabled="True" Click="OpenCppExtensions_Click" Style="{StaticResource ModernButton}" Padding="10,5" Margin="0,3,8,3" Background="#0E639C" BorderBrush="#1177BB" ToolTip="Apri Estensioni C++: libreria matematica Mate"/>
                            <TextBlock Text="SHIFT+CLICK: TUTTO SCHERMO" Foreground="#D7BA7D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Margin="8,7,7,8" CornerRadius="12" Background="#1E1E1E" BorderBrush="#2B4567" BorderThickness="1" ClipToBounds="True">
                <TabControl x:Name="EditorTabs" Background="#050B14" BorderThickness="0">
                    <TabItem Header="main.cpp">
                        <avalonEdit:TextEditor x:Name="Editor" ShowLineNumbers="True" FontFamily="Cascadia Mono, Consolas" FontSize="16"
                                               Background="#1E1E1E" Foreground="#D4D4D4" LineNumbersForeground="#858585" Padding="10"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                               TextChanged="Editor_TextChanged" PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown"/>
                    </TabItem>
                    <TabItem x:Name="HeaderTab" Header="esercizio.h" Visibility="Collapsed">
                        <avalonEdit:TextEditor x:Name="HeaderEditor" ShowLineNumbers="True" FontFamily="Cascadia Mono, Consolas" FontSize="16"
                                               Background="#1E1E1E" Foreground="#D4D4D4" LineNumbersForeground="#858585" Padding="10"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                               TextChanged="HeaderEditor_TextChanged" PreviewMouseLeftButtonDown="HeaderEditor_PreviewMouseLeftButtonDown"/>
                    </TabItem>
                </TabControl>
                </Border>



                <Grid x:Name="ShellPanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#0C0C0C">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ShellOutputBox" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" BorderThickness="0" Background="#0C0C0C" Foreground="#E5E5E5"
                             FontFamily="Cascadia Mono, Consolas" FontSize="14" Padding="10"/>
                    <DockPanel Grid.Row="1" Background="#111111" LastChildFill="True" Margin="0,1,0,0">
                        <TextBlock Text=">" Foreground="#22C55E" FontFamily="Cascadia Mono, Consolas" FontSize="15"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,7,0"/>
                        <TextBox x:Name="ShellInputBox" Background="#111111" Foreground="White" BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="14" Padding="4,7"
                                 PreviewKeyDown="ShellInputBox_KeyDown"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.RowSpan="3" HorizontalAlignment="Right" Width="400" Margin="0,46,16,8" CornerRadius="10" Background="#0B1729" BorderBrush="#2B4567" BorderThickness="1">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="ESERCIZI CREATI" Foreground="#69C7FF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="Fai clic su un esercizio per aprirlo nell'editor." Foreground="#9CB4CF" FontSize="10" Margin="0,3,0,8" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ListBox x:Name="ExerciseListBox" Grid.Row="1" SelectionChanged="ExerciseListBox_SelectionChanged"
                                 Background="#07101C" Foreground="#E7F4FF" BorderBrush="#243650" BorderThickness="1"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="4"
                                 DisplayMemberPath="Label"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="RenameExerciseButton" Content="Rinomina / cambia numero"
                                    Click="RenameSelectedExercise_Click" Style="{StaticResource ModernButton}"
                                    Background="#0E639C" BorderBrush="#2AAEFF" Margin="0,0,8,0" Padding="10,7"/>
                            <Button x:Name="DeleteExerciseButton" Content="🗑" ToolTip="Elimina esercizio selezionato" Width="48"
                                    Click="DeleteSelectedExercise_Click" Style="{StaticResource ModernButton}"
                                    Background="#7F1D1D" BorderBrush="#EF4444" Margin="0" Padding="10,7"/>
                        </StackPanel>
                    </Grid>
                </Border>

        <!-- Trascina questa barra per regolare l'altezza dell'editor e dell'output. -->
        <GridSplitter Grid.Row="3" Margin="16,0,424,0" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#263A55" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                      Cursor="SizeNS" ToolTip="Trascina per regolare l'altezza dell'editor"/>

        <Border x:Name="OutputPanel" Grid.Row="4" Margin="16,0,424,0" CornerRadius="14" Background="{StaticResource PanelBrush}" BorderBrush="#243650" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#132139"><Grid Margin="13,0"><TextBlock Text="COMPILAZIONE ED ESECUZIONE" Foreground="#BBD0E8" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="SHIFT+CLICK: apri a tutto schermo" Foreground="#FFD166" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
                <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" BorderThickness="0" Background="#07101C" Foreground="#E7F4FF" FontFamily="Cascadia Mono, Consolas" Padding="12" PreviewMouseLeftButtonDown="OutputBox_PreviewMouseLeftButtonDown"/>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="#0B1729" BorderBrush="#20324C"
                BorderThickness="0,1,0,0" Margin="0,8,0,0">
            <Grid Margin="14,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="RunButton" Grid.Column="0" Content="Compila ed esegui"
                        Click="Run_Click" Style="{StaticResource ModernButton}"
                        Background="#059669" BorderBrush="#19C790" VerticalAlignment="Center"/>

                <Button x:Name="AddHeaderButton" Grid.Column="1" Content="Aggiungi esercizio.h" IsEnabled="False"
                        Click="AddHeader_Click" Style="{StaticResource ModernButton}"
                        Background="#7C3AED" BorderBrush="#9F7AEA" VerticalAlignment="Center"/>

                <Button x:Name="RenameHeaderButton" Grid.Column="2" Content="Rinomina .h" IsEnabled="False"
                        Click="RenameHeader_Click" Style="{StaticResource ModernButton}"
                        Background="#9333EA" BorderBrush="#C084FC" VerticalAlignment="Center"/>

                <Button x:Name="DeleteHeaderButton" Grid.Column="3" Content="Elimina .h" IsEnabled="False"
                        Click="DeleteHeader_Click" Style="{StaticResource ModernButton}"
                        Background="#B91C1C" BorderBrush="#F87171" VerticalAlignment="Center"/>

                <!-- Il comando è mostrato nella finestra Estensioni C++; questo controllo nascosto
                     conserva lo stato/autorizzazione usato dalla logica esistente. -->
                <Button x:Name="ImportHeaderButton" Grid.Column="4" Content="Importa .h/.hpp" IsEnabled="False"
                        Click="ImportHeader_Click" Style="{StaticResource ModernButton}"
                        Background="#0F766E" BorderBrush="#2DD4BF" VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTip="Importa un file header locale nell'editor C++"/>

                <Button x:Name="SendButton" Grid.Column="5" Content="Invia al docente"
                        Click="Send_Click" Style="{StaticResource ModernButton}"
                        Background="#0E8FE8" BorderBrush="#44B7FF" VerticalAlignment="Center"/>

                <Button x:Name="GoogleDriveButton" Grid.Column="6" Content="Google Drive"
                        Click="GoogleDrive_Click" Style="{StaticResource ModernButton}"
                        Background="#FFFFFF" Foreground="#1F2937" BorderBrush="#D1D5DB" VerticalAlignment="Center"
                        ToolTip="Accedi con il tuo account Google e salva l'esercizio nel tuo Drive"/>

                <TextBlock x:Name="CurrentTaskSummaryText" Grid.Column="10"
                           Text="Tipologia — • esercizio 1" Foreground="#BDD6F3"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           HorizontalAlignment="Right" TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" Margin="8,0,10,0"/>

                <Button x:Name="TestServerButton" Grid.Column="7" Content="Test server"
                        Click="TestServer_Click" Style="{StaticResource ModernButton}"
                        Background="#5B4FE8" BorderBrush="#746BFF" VerticalAlignment="Center"/>

                <ProgressBar x:Name="ServerTestProgress" Grid.Column="8"
                             Height="8" Margin="4,0,12,0" IsIndeterminate="True"
                             Visibility="Collapsed" VerticalAlignment="Center"
                             Foreground="#47D7FF" Background="#10243A"/>

                <TextBlock x:Name="StatusText" Grid.Column="9" Text="Pronto"
                           Foreground="#A8B5C7" VerticalAlignment="Center" Margin="8,0"/>

                <Button x:Name="UpdateButton" Grid.Column="11" Content="Ricerca aggiornamenti"
                        Click="CheckUpdates_Click" Style="{StaticResource ModernButton}"
                        Background="#0F4C75" BorderBrush="#38BDF8" VerticalAlignment="Center"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>