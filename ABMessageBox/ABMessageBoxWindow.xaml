<Window x:Class="ABMessageBox.ABMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compilatore alunno"
        Width="500" Height="270"
        MinWidth="440" MinHeight="235"
        MaxWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Border CornerRadius="14" Background="#FFFDFDFD" BorderBrush="#FFD7D7D7" BorderThickness="1" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF0F356E" CornerRadius="14,14,0,0">
                <Grid Margin="18,0,12,0">
                    <TextBlock Text="Compilatore alunno"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <Button Content="✕" Width="32" Height="32"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="15"
                            Cursor="Hand" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,18,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconCircle" Width="46" Height="46" CornerRadius="23"
                        VerticalAlignment="Top" Background="#FFE8EEF7">
                    <TextBlock x:Name="IconText" Text="i" FontSize="25" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#FF2D67B2"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="CaptionText"
                               Margin="0,0,0,8"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#FF17365D"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText"
                               FontSize="14.5"
                               Foreground="#FF202020"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,20,0"/>
            </Border>

            <Border Grid.Row="3" Background="#FFF3F3F3" CornerRadius="0,0,14,14">
                <TextBlock Text="© Alessandro Barazzuol"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" Foreground="#FF6B6B6B"/>
            </Border>
        </Grid>
    </Border>
</Window>
