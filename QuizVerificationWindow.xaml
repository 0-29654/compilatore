<Window x:Class="CppStudentClient.QuizVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verifica Quiz" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="True" ShowInTaskbar="False" Background="#F4F7FB">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#673AB7" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Verifica" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="StudentText" Foreground="#EDE9FE" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#4C1D95" CornerRadius="8" Padding="14,8">
                    <TextBlock x:Name="TimerText" Text="00:00" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="QuestionsPanel" Margin="60,28,60,28" MaxWidth="980" HorizontalAlignment="Center"/>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#D8DEE9" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Le risposte vengono mantenute fino alla consegna." Foreground="#64748B" VerticalAlignment="Center"/>
                <Button x:Name="SubmitButton" Grid.Column="1" Content="Invia verifica" Click="SubmitButton_Click" Background="#673AB7" Foreground="White" FontWeight="Bold" Padding="26,10" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
